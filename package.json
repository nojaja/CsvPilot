{
    "name": "csvpilot",
    "version": "1.0.3",
    "description": "CLI tool to batch-process large CSV datasets using the GitHub Copilot SDK with a unified prompt template",
    "main": "dist/csvpilot.bundle.js",
    "bin": {
        "csvpilot": "./dist/csvpilot.bundle.js"
    },
    "scripts": {
        "build": "webpack --config webpack.config.js",
        "build:dev": "webpack --config webpack.config.js --mode development",
        "test": "jest --config jest.unit.config.js",
        "test:coverage": "jest --config jest.unit.config.js --coverage",
        "test:e2e": "jest --config jest.e2e.config.js",
        "test:all": "npm test && npm run test:e2e",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "depcruise": "depcruise src --config .dependency-cruiser.cjs",
        "type-check": "tsc --noEmit",
        "clean": "rimraf dist"
    },
    "keywords": [
        "csv",
        "copilot",
        "cli",
        "ai",
        "rbql"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nojaja/CsvPilot.git"
    },
    "author": "nojaja <free.riccia@gmail.com> (https://github.com/nojaja)",
    "license": "Apache 2.0 License",
    "bugs": {
        "url": "https://github.com/nojaja/CsvPilot/issues"
    },
    "homepage": "https://github.com/nojaja/CsvPilot#readme",
    "dependencies": {
        "@github/copilot-sdk": "^0.3.0",
        "@nojaja/dirwalker": "^1.0.2",
        "@nojaja/pathutil": "^1.0.9",
        "commander": "^12.0.0",
        "csv-parse": "^5.5.6",
        "csv-stringify": "^6.5.1",
        "handlebars": "^4.7.8",
        "nodeconfigloder": "^1.0.1",
        "rbql": "^0.30.0"
    },
    "devDependencies": {
        "@types/handlebars": "^4.1.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^20.0.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "dependency-cruiser": "^16.0.0",
        "eslint": "^8.57.0",
        "eslint-plugin-sonarjs": "^0.25.0",
        "jest": "^29.7.0",
        "jest-runner-cli": "^0.2.8",
        "rimraf": "^5.0.0",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.1",
        "typescript": "^5.9.3",
        "webpack": "^5.106.2",
        "webpack-cli": "^5.1.4"
    },
    "files": [
        "dist/csvpilot.bundle.js"
    ]
}
