{
    "name": "csvpilot",
    "version": "1.2.5",
    "type": "commonjs",
    "description": "CLI for batch CSV processing with GitHub Copilot SDK and reusable prompts",
    "main": "dist/csvpilot.bundle.js",
    "types": "dist/index.d.ts",
    "bin": {
        "csvpilot": "dist/csvpilot.bundle.js"
    },
    "scripts": {
        "build": "webpack --config webpack.config.js",
        "build:dev": "webpack --config webpack.config.js --mode development",
        "test": "jest --config jest.unit.config.js",
        "test:ci": "jest --config jest.unit.config.js --coverage",
        "test:coverage": "jest --config jest.unit.config.js --coverage",
        "test:e2e": "jest --config jest.e2e.config.js",
        "test:all": "npm test && npm run test:e2e",
        "docs": "typedoc --options typedoc.js",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "cpd": "jscpd src --min-lines 5 --min-tokens 50 --threshold 0",
        "depcruise": "depcruise src --config .dependency-cruiser.js",
        "typecheck": "npm run type-check",
        "type-check": "tsc --noEmit",
        "clean": "rimraf dist"
    },
    "keywords": [
        "csv",
        "copilot",
        "copilot-sdk",
        "cli",
        "ai",
        "rbql"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nojaja/CsvPilot.git"
    },
    "author": "nojaja <free.riccia@gmail.com> (https://github.com/nojaja)",
    "license": "Apache 2.0 License",
    "bugs": {
        "url": "https://github.com/nojaja/CsvPilot/issues"
    },
    "homepage": "https://github.com/nojaja/CsvPilot#readme",
    "dependencies": {
        "@github/copilot-sdk": "^0.3.0",
        "@nojaja/dirwalker": "^1.0.2",
        "@nojaja/pathutil": "^1.0.9",
        "commander": "^12.0.0",
        "csv-parse": "^5.5.6",
        "csv-stringify": "^6.5.1",
        "handlebars": "^4.7.8",
        "js-yaml": "^4.1.1",
        "nodeconfigloder": "^1.0.1",
        "rbql": "^0.30.0"
    },
    "devDependencies": {
        "@types/handlebars": "^4.1.0",
        "@types/jest": "^29.5.14",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^20.0.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "dependency-cruiser": "^16.0.0",
        "eslint": "^8.57.0",
        "eslint-plugin-jsdoc": "^62.9.0",
        "eslint-plugin-sonarjs": "^0.25.0",
        "jest": "^29.7.0",
        "jest-runner-cli": "^0.2.8",
        "jscpd": "^4.0.9",
        "rimraf": "^5.0.0",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.1",
        "typedoc": "^0.28.19",
        "typedoc-plugin-markdown": "^4.11.0",
        "typescript": "^5.9.3",
        "webpack": "^5.106.2",
        "webpack-cli": "^5.1.4"
    },
    "files": [
        "dist",
        "package.json",
        "README.md",
        "README_ja.md",
        "LICENSE"
    ]
}
